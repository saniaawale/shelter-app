Copy values into backend/.env without removing existing settings.
# Get the Postgres connection URI from your Supabase project's Connect panel.
# For passwords containing reserved URL characters, use their percent-encoded form.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Set this to the exact staff-maintained status that means CURRENT availability
# has been confirmed. Example only: available. Null statuses are never eligible.
MATCHING_AVAILABLE_STATUS=available
FRONTEND_ORIGIN=http://localhost:5173